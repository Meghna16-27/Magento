<?xml version="1.0"?>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Concrete configuration for the payment method -->
    <virtualType name="CodilarOfflinePaymentConfig"
                 type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">
                Codilar\OfflinePayment\Model\Payment\OfflinePayment::CODE
            </argument>
        </arguments>
    </virtualType>

    <!-- Supply the concrete configuration to the value handler -->
    <virtualType name="CodilarOfflinePaymentConfigValueHandler"
                 type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">
                CodilarOfflinePaymentConfig
            </argument>
        </arguments>
    </virtualType>

    <!-- Pool of configuration value handlers -->
    <virtualType name="CodilarOfflinePaymentValueHandlerPool"
                 type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">
                    CodilarOfflinePaymentConfigValueHandler
                </item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Payment method adapter -->
    <virtualType name="CodilarOfflinePaymentFacade"
                 type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">
                Codilar\OfflinePayment\Model\Payment\OfflinePayment::CODE
            </argument>
            <argument name="formBlockType" xsi:type="string">
                Magento\Payment\Block\Form
            </argument>
            <argument name="infoBlockType" xsi:type="string">
                Magento\Payment\Block\Info
            </argument>
            <argument name="valueHandlerPool" xsi:type="object">
                CodilarOfflinePaymentValueHandlerPool
            </argument>
        </arguments>
    </virtualType>

</config>
