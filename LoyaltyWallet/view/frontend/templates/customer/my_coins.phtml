<?php
/** @var Coins $block */

use Codilar\LoyaltyWallet\Block\Customer\Coins;

$totalCoins = $block->getTotalCoins();
$transactions = $block->getCustomerTransactions();
?>

<div class="loyalty-coins-dashboard">

    <!-- Balance Header -->
    <div class="loyalty-coins-header">

        <div>
            <h2 class="loyalty-coins-title">
                <?= __('My Coins Balance') ?>
            </h2>

            <div class="loyalty-coins-balance">
                🪙 <?= (int)$totalCoins ?>

                <span class="loyalty-coins-balance-label">
                    <?= __('Coins Available') ?>
                </span>
            </div>
        </div>

        <!-- Conversion Form -->
        <div class="coin-conversion-box">

            <form
                action="<?= $block->getUrl('loyalty/wallet/convert') ?>"
                method="POST"
                id="coin-conversion-form"
                class="coin-conversion-form"
            >

                <?= $block->getBlockHtml('formkey') ?>

                <div>
                    <label
                        for="coins_to_convert"
                        class="coin-conversion-label"
                    >
                        <?= __('Convert to Wallet (1 Coin = ₹1):') ?>
                    </label>

                    <input
                        type="number"
                        name="coins_to_convert"
                        id="coins_to_convert"
                        min="1"
                        step="1"
                        max="<?= (int)$totalCoins ?>"
                        value="<?= (int)$totalCoins ?>"
                        placeholder="<?= __('Enter coins') ?>"
                        class="input-text coin-conversion-input"
                        required
                    />
                </div>

                <button
                    type="submit"
                    class="action submit primary coin-conversion-button"
                >
                    <span><?= __('Convert') ?></span>
                </button>

            </form>

        </div>
    </div>


    <!-- Transaction History -->
    <div class="coins-history">

        <h3 class="coins-history-title">
            <?= __('Coins Transaction History') ?>
        </h3>

        <?php if (!empty($transactions)): ?>

            <div class="table-wrapper coins-table-wrapper">

                <table class="data table table-order-items coins-table">

                    <thead>
                    <tr>
                        <th><?= __('Order ID') ?></th>
                        <th><?= __('Coins Movement') ?></th>
                        <th><?= __('Expires On') ?></th>
                        <th><?= __('Balance After') ?></th>
                        <th><?= __('Date') ?></th>
                    </tr>
                    </thead>

                    <tbody>

                    <?php foreach ($transactions as $txn): ?>

                        <?php
                        $qty = (int)$txn->getQuantity();
                        $isPositive = $qty > 0;
                        $comment = $txn->getComment();
                        $createdAt = $txn->getCreatedAt();

                        $expiresOnFormatted = '-';

                        if ($isPositive && $createdAt) {
                            $expiryDate = new DateTime($createdAt);
                            $expiryDate->modify('+12 months');
                            $expiresOnFormatted = $expiryDate->format('M d, Y H:i');
                        }
                        ?>

                        <tr>

                            <td>
                                <strong>
                                    #<?= $block->escapeHtml($txn->getOrderIncrementId() ?? 'N/A') ?>
                                </strong>
                            </td>

                            <td
                                class="coins-movement <?= $isPositive ? 'coins-movement-positive' : 'coins-movement-negative' ?>"
                            >
                                <?= $isPositive ? '+' . $qty : $qty ?>

                                <span class="coins-movement-description">

                                    <?php if ($isPositive): ?>

                                        <?= __('Earned from Purchase') ?>

                                    <?php elseif ($comment === 'Points Expired'): ?>

                                        <?= __('Expired (FIFO rule)') ?>

                                    <?php elseif ($comment === 'Order Canceled'): ?>

                                        <?= __('Reversed due to Order Cancellation') ?>

                                    <?php else: ?>

                                        <?= $block->escapeHtml($comment) ?>

                                    <?php endif; ?>

                                </span>
                            </td>

                            <td class="coins-expiry-cell">

                                <?php if ($isPositive): ?>

                                    <span class="coins-expiry">
                                        <?= $block->escapeHtml($expiresOnFormatted) ?>
                                    </span>

                                <?php else: ?>

                                    -

                                <?php endif; ?>

                            </td>

                            <td>
                                <?= (int)$txn->getBalanceAfter() ?>
                            </td>

                            <td class="coins-date">
                                <?= $block->escapeHtml($createdAt) ?>
                            </td>

                        </tr>

                    <?php endforeach; ?>

                    </tbody>

                </table>

            </div>

        <?php else: ?>

            <div class="message info empty coins-empty-message">
                <span>
                    <?= __('You have no coin transactions yet.') ?>
                </span>
            </div>

        <?php endif; ?>

    </div>

</div>
