<?xml version="1.0" encoding="UTF-8"?>

<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                codilar_product_restriction_product_listing.codilar_product_restriction_product_listing_data_source
            </item>
        </item>
    </argument>

    <settings>
        <spinner>columns</spinner>

        <deps>
            <dep>
                codilar_product_restriction_product_listing.codilar_product_restriction_product_listing_data_source
            </dep>
        </deps>
    </settings>

    <!-- Data Source -->
    <dataSource name="codilar_product_restriction_product_listing_data_source"
                component="Magento_Ui/js/grid/provider">

        <settings>
            <updateUrl path="mui/index/render"/>
        </settings>
        <dataProvider name="codilar_product_restriction_product_listing_data_source"
                      class="Magento\Catalog\Ui\DataProvider\Product\ProductDataProvider">

            <settings>
                <requestFieldName>entity_id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>

        </dataProvider>
    </dataSource>

    <!-- Grid Columns -->
    <columns name="columns">
        <selectionsColumn name="ids" component="Codilar_ProductRestriction/js/grid/columns/single-select">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>

        <!-- Product ID -->
        <column name="entity_id">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>asc</sorting>
            </settings>
        </column>

        <!-- SKU -->
        <column name="sku">
            <settings>
                <filter>text</filter>
                <label translate="true">SKU</label>
            </settings>
        </column>

        <!-- Product Name -->
        <column name="name">
            <settings>
                <filter>text</filter>
                <label translate="true">Product Name</label>
                <addField>true</addField>
            </settings>
        </column>

        <!-- Price -->
        <column name="price" class="Magento\Catalog\Ui\Component\Listing\Columns\Price">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Price</label>
                <addField>true</addField>
            </settings>
        </column>

    </columns>

</listing>
