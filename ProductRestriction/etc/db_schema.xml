<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:setup:Declaration/Schema/etc/db_schema.xsd">
    <table name="codilar_product_restriction" resource="default" engine="innodb" comment="Product Restriction Table">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="varchar" name="sku" nullable="false" length="255" comment="Product SKU"/>
        <column xsi:type="int" name="max_qty" padding="10" unsigned="true" nullable="false" default="0" comment="Maximum Allowed Quantity"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="CODILAR_PRODUCT_RESTRICTION_SKU">
            <column name="sku"/>
        </constraint>
    </table>
</schema>
